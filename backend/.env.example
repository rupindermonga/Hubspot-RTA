# Copy this file to .env and fill in your values.
# In production, secrets come from Doppler — this file is for new-laptop bootstrap only.

# JWT Secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# If left as placeholder, the app auto-generates a random secret (tokens won't survive restarts)
JWT_SECRET=change-this-to-a-long-random-secret-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# Database (SQLCipher-encrypted SQLite). The DB file is opaque without DB_ENCRYPTION_KEY.
DATABASE_URL=sqlite:///./hubspot_rta.db

# DB encryption key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
# 64-char hex (256-bit). MUST be set; service refuses to start without it.
# In prd this comes from Doppler. In dev, fill into .env locally.
DB_ENCRYPTION_KEY=CHANGE_ME_to_64_char_hex

# CORS — comma-separated list of allowed origins (no wildcards in production)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Set to "false" to enable /docs and /openapi.json (default: true = hidden)
DISABLE_DOCS=true

# Admin bootstrap credentials (used by create_admin.py)
# IMPORTANT: Change the password before running create_admin.py!
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE_ME_min_8_chars
ADMIN_EMAIL=admin@example.com

# Per-IP login rate limit (failed attempts per 2-minute window)
LOGIN_RATE_LIMIT=30

# Max upload row count + size (defensive guard)
MAX_UPLOAD_ROWS=50000
MAX_UPLOAD_MB=50
